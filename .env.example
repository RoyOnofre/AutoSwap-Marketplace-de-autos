# .env.example
# Supabase PostgreSQL connection URL
SUPABASE_URL=postgresql://username:password@db.supabase.co:5432/postgres

# Supabase JWT secret (o clave pública) usado para validar los tokens
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_or_public_key

# Token de acceso de Mercado Pago (para pagos)
MERCADO_PAGO_ACCESS_TOKEN=your_mercado_pago_access_token

# Puerto donde arranca la API (por defecto 3000)
PORT=3000

# Variables de entorno para el front-end
VITE_GATEWAY_URL=http://localhost:3001/v1
VITE_API_URL=http://localhost:8004/api
